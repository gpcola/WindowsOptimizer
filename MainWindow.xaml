<Window x:Class="WindowsOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Optimizer by 1LG Digital"
        Height="820"
        Width="1180"
        MinWidth="980"
        MinHeight="700"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrandBrush" Color="#5B21B6"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
        </Style>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="1LG DIGITAL" Foreground="{StaticResource BrandBrush}" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="Windows Optimizer" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,4"/>
                    <TextBlock Text="Safe Windows housekeeping and performance maintenance. No installed Windows features are removed."/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="Refresh Disk Info" Width="150" Click="RefreshDisk_Click" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtSpaceInfo" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Housekeeping">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="410"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Safe housekeeping" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <CheckBox x:Name="chkTemp" IsChecked="True"
                                          Content="Clean stale temporary files"
                                          ToolTip="Only top-level temporary/log files older than 30 days are considered. Locked files are skipped."/>
                                <CheckBox x:Name="chkRecycle" IsChecked="True"
                                          Content="Empty Recycle Bin"
                                          ToolTip="Permanently removes items already placed in the Windows Recycle Bin."/>
                                <CheckBox x:Name="chkUpdates" IsChecked="True"
                                          Content="Clear Windows Update download cache when idle"
                                          ToolTip="Runs only when servicing and update transfers are idle. Service state is restored."/>
                                <CheckBox x:Name="chkWinSxS" IsChecked="True"
                                          Content="Clean Windows component store"
                                          ToolTip="Uses DISM StartComponentCleanup without ResetBase, preserving normal servicing rollback behaviour."/>
                                <CheckBox x:Name="chkBloat"
                                          Content="Remove selected optional consumer apps"
                                          ToolTip="Advanced opt-in only. Uses an exact allowlist and asks for confirmation before uninstalling anything."/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="btnRunSelected" Content="Run Selected" Width="130" Click="RunSelected_Click"/>
                                    <Button x:Name="btnRunSafeHousekeeping" Content="Run Safe Housekeeping" Width="190" Click="RunSafeHousekeeping_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Safety boundaries" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="• Installed Windows optional features are never disabled or removed." TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Indexing, Windows services, pagefile settings, hibernation, restore points and background-app policies are not changed." TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Application data and browser profiles are never cleanup targets. In-use or uncertain files are skipped." TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Safe Housekeeping excludes app removal. Optional consumer app removal is always a separate, confirmed choice." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Automatic run summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBox x:Name="txtBenchmarkComparison" Height="220" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Performance">
                <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Windows-native drive optimisation" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Windows detects the media type and chooses the appropriate optimisation automatically, such as TRIM for supported SSDs or defragmentation for HDDs." TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="btnOptimizeDrive" Content="Optimize System Drive" Width="180" Click="OptimizeSystemDrive_Click"/>
                                    <Button Content="Open Startup Apps" Width="150" Click="OpenStartupApps_Click"/>
                                    <Button Content="Open Storage Settings" Width="170" Click="OpenStorageSettings_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="LAN media streaming" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Turn this PC into a Windows media streaming device for trusted devices on your private LAN. If legacy Windows Media components are missing, Windows Optimizer can add them after asking you first. It never removes media features." TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtMediaStreamingStatus" Text="Checking media streaming status..." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="btnEnableMediaStreaming" Content="Enable LAN Media Streaming" Width="210" Click="EnableMediaStreaming_Click"/>
                                    <Button x:Name="btnDisableMediaStreaming" Content="Turn Off Media Streaming" Width="190" Click="DisableMediaStreaming_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Performance policy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Windows Optimizer deliberately avoids registry-cleaner behaviour and broad service disabling. Changes that trade functionality for tiny benchmark gains are not treated as performance improvements." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Benchmark">
                <Border Margin="12" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Performance snapshot" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Take BEFORE snapshot" Width="170" Margin="0,0,10,0" Click="BenchmarkBefore_Click"/>
                            <Button Content="Take AFTER snapshot" Width="170" Margin="0,0,10,0" Click="BenchmarkAfter_Click"/>
                            <Button Content="Compare" Width="110" Click="CompareBenchmark_Click"/>
                        </StackPanel>
                        <TextBlock Text="Before snapshot:" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtBenchmarkBefore" Height="110" Margin="0,6,0,12" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="After snapshot:" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtBenchmarkAfter" Height="110" Margin="0,6,0,12" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="Activity log" Margin="0,10,0,0">
            <TextBox x:Name="txtLog" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" IsReadOnly="True"/>
        </GroupBox>
    </Grid>
</Window>