<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <AssemblyName>WindowsOptimizer</AssemblyName>
    <Product>Windows Optimizer</Product>
    <Company>1LG Digital</Company>
    <Authors>1LG Digital</Authors>
    <Description>Safe Windows housekeeping and performance maintenance by 1LG Digital.</Description>
    <Copyright>Copyright © 1LG Digital 2026</Copyright>
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Compile Include="App.xaml.cs" />
    <Compile Include="MainWindow.xaml.cs" />
    <Compile Include="MainWindow.QuickClean.cs" />
    <Compile Include="MainWindow.MediaStreaming.cs" />
    <Compile Include="BenchmarkHelper.cs" />
    <Compile Include="DiskHelper.cs" />
    <Compile Include="Logger.cs" />
    <Compile Include="Optimizer.cs" />
    <Compile Include="PowerShellHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\App.ico" />
    <None Include="Assets\App.png" />
    <None Include="Installer\WindowsOptimizer.iss" />
  </ItemGroup>

</Project>
